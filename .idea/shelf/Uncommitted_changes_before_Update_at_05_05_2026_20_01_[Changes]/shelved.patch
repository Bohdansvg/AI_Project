+    totalOf(totalOf: TotalOfUnit): number;
+    /**
+     * Creates a Duration from a DurationLike, which is an object
+     * containing zero or more of the following: hours, seconds,
+     * minutes, millis.
+     */
+    static from(durationLike: DurationLike): Duration;
+}
